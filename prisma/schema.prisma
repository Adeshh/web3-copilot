// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// Prisma 7: connection URLs live in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
  extensions = [vector]
}

/// One chat thread. Holds many messages.
model Conversation {
  id        String   @id @default(cuid())
  userId    String?   //Optional so exsisting anonymous chats remain visible
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

/// A single turn in a conversation — either what the user asked
/// or what the model answered.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           Role
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // The query we always run: "messages for conversation X, oldest first."
  @@index([conversationId, createdAt])
}

model TransactionAnalysis {
  id            String @id @default(cuid())
  hash          String
  explanation   String
  createdAt     DateTime @default(now())
}
  
enum Role {
  USER
  ASSISTANT
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?        // Encrypted password for credentials login
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id            String   @id @default(cuid())
  source        String   //ex- "ERC20"
  chunk         String   //Actual content
  embedding     Unsupported("vector(3072)")? // The mathematical vector representation
  createdAt     DateTime @default(now())
}

model AgentState {
  id            String   @id @default(cuid())
  threadId      String   //This will link to our conversation id
  checkpoint    Json     //Langgraph will dump its brain state here
  createdAt     DateTime @default(now())

  @@index([threadId])
}


