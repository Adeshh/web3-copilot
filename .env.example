# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real keys.

# Required. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. PostgreSQL connection strings (Neon).
# DATABASE_URL is the POOLED connection  — hostname contains "-pooler".
# DIRECT_URL is the UNPOOLED connection  — used only by `prisma migrate`,
# which cannot run through a connection pooler.
DATABASE_URL=
DIRECT_URL=

# Optional. Google Cloud project details; not read by the app code yet.
NAME=
PROJECT_NAME=
PROJECT_NUMBER=

# Web3 APIs (Required for Wallet and AI Insights)
ETHERSCAN_API_KEY=
ETHEREUM_RPC_URL=
